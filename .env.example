# Copy to .env and fill in. .env is gitignored — NEVER commit real values.

# Odysseus target (reuse from the eval pipeline's .env)
ODYSSEUS_BASE_URL=http://localhost:7000
ODYSSEUS_TOKEN=

# LLM for guardrail-side judges / quarantined-LLM (dual-LLM). ROTATE before use —
# this key was previously shared in plaintext.
OPENAI_API_KEY=

# Mistral Moderation API (output content classifier). Native to the Mistral-backed agent.
MISTRAL_API_KEY=

# Optional: where to load the sibling .env from, if not in this repo.
# GUARDRAILS_ENV_FALLBACK=../Agent evals/Agent eval pipeline/.env
